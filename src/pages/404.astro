---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../config/site";
---

<Base noindex>
  <Header />
  <main id="contenido" class="bg-ink pt-16 text-paper">
    <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
      <h1 class="max-w-2xl text-4xl leading-tight font-bold sm:text-5xl">{site.notFound.title}</h1>
      <p class="mt-5 max-w-xl text-lg text-muted-dark">{site.notFound.text}</p>
      <a href="/" class="btn-primary mt-9">{site.notFound.cta}</a>
    </div>
  </main>
  <Footer />
</Base>
