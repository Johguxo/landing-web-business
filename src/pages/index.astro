---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problems from "../components/Problems.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Services from "../components/Services.astro";
import Process from "../components/Process.astro";
import Why from "../components/Why.astro";
import Roi from "../components/Roi.astro";
import Audience from "../components/Audience.astro";
import Team from "../components/Team.astro";
import Faq from "../components/Faq.astro";
import Booking from "../components/Booking.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
---

<Base>
