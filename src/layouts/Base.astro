---
import "../styles/global.css";
import { Font } from "astro:assets";
import { site } from "../config/site";
import Analytics from "../components/Analytics.astro";

interface Props {
  /** Excluye la página de los buscadores (ej. 404). */
  noindex?: boolean;
}
const { noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL("/og-image.png", site.url).href;
const { title, description } = site.seo;

// Datos estructurados: ayudan a Google a mostrar el logo y vincular a LinkUs con sus fundadores y perfiles.
const sameAs = [site.contact.linkedin].filter(Boolean);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site.url}/#organization`,
      name: site.name,
      slogan: site.tagline,
      url: `${site.url}/`,
      logo: new URL("/logo.png", site.url).href,
      image: ogImage,
      description,
      email: site.contact.email,
      telephone: `+${site.contact.whatsapp.replace(/\D/g, "")}`,
      address: { "@type": "PostalAddress", addressLocality: "Lima", addressCountry: "PE" },
      areaServed: { "@type": "Country", name: "Perú" },
      ...(sameAs.length ? { sameAs } : {}),
      founder: site.team.people.map((p) => ({
        "@type": "Person",
        name: p.name,
        jobTitle: p.role.split(" · ")[0],
        ...(p.linkedin ? { sameAs: [p.linkedin] } : {}),
      })),
    },
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.name,
      url: `${site.url}/`,
      inLanguage: "es-PE",
      publisher: { "@id": `${site.url}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.seo.googleVerification && <meta name="google-site-verification" content={site.seo.googleVerification} />}
    <meta name="theme-color" content="#0E1B2E" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph (WhatsApp, LinkedIn, Facebook) -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={site.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-sora" preload={[{ weight: 700 }]} />
    <Font cssVariable="--font-plex" preload={[{ weight: 400 }]} />

    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}

    <Analytics />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded focus:bg-amber focus:px-4 focus:py-2 focus:text-ink"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
