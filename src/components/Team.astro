---
/**
 * Quiénes están detrás: los socios. La confianza en una consultoría viene de las personas.
 * Si falta una foto, se muestra un marcador visible.
 */
import { site } from "../config/site";
import Icon from "./Icon.astro";
import Marked from "./Marked.astro";

const t = site.team;
---

<section id="quien" class="border-t border-line bg-surface py-16 sm:py-24" aria-labelledby="quien-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-3xl">
      <h2 id="quien-title" class="text-3xl leading-tight font-bold sm:text-4xl">{t.title}</h2>
      <p class="mt-4 text-lg text-muted">{t.intro}</p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:gap-8">
      {
        t.people.map((person) => (
          <article class="flex flex-col rounded-2xl border border-line bg-paper p-5 sm:p-7">
            <div class="flex items-center gap-5">
              {person.photo ? (
                <img
                  src={person.photo}
                  alt={`Foto de ${person.name}`}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="h-24 w-24 shrink-0 rounded-2xl object-cover sm:h-32 sm:w-32"
                />
              ) : (
                <div
                  class="flex h-24 w-24 shrink-0 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-amber bg-[#fff1d6] text-[#6b4a0e] sm:h-32 sm:w-32"
                  role="img"
                  aria-label={`Falta la foto de ${person.name}`}
                >
                  <Icon name="user" size={36} />
                  <span class="mt-1 text-[0.7rem] font-semibold">[FOTO]</span>
                </div>
              )}
              <div class="min-w-0">
                <h3 class="text-xl font-bold sm:text-2xl">{person.name}</h3>
                <p class="mt-1 font-medium text-brand">
                  {person.role.split(" · ").map((part, i) => (
                    <>
                      {i > 0 && <span class="hidden sm:inline"> · </span>}
                      <span class="block sm:inline">{part}</span>
                    </>
                  ))}
                </p>
              </div>
            </div>
            <p class="mt-5 text-[0.95rem] font-medium">{person.credentials}</p>
            <p class="mt-3 text-muted">
              <Marked text={person.bio} />
            </p>
            {person.linkedin && (
              <a href={person.linkedin} target="_blank" rel="noopener" class="link mt-4 inline-flex items-center gap-2 font-medium">
                <Icon name="linkedin" size={20} />
                Ver perfil en LinkedIn
                <span class="sr-only">(se abre en una nueva pestaña)</span>
              </a>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
