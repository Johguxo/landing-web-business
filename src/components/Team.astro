---
/**
 * Quién está detrás: la confianza en una consultoría viene de las personas.
 * Si falta la foto, se muestra un marcador visible.
 */
import { site } from "../config/site";
import Icon from "./Icon.astro";
import Marked from "./Marked.astro";

const t = site.team;
---

<section id="quien" class="border-t border-line bg-surface py-16 sm:py-24" aria-labelledby="quien-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="quien-title" class="text-3xl leading-tight font-bold sm:text-4xl">{t.title}</h2>

    {
      t.people.map((person) => (
        <article class="mt-10 grid items-center gap-8 sm:grid-cols-[220px_1fr] lg:grid-cols-[300px_1fr] lg:gap-14">
          {person.photo ? (
            <img
              src={person.photo}
              alt={`Foto de ${person.name}`}
              width="600"
              height="600"
              loading="lazy"
              decoding="async"
              class="aspect-square w-48 rounded-2xl object-cover sm:w-full"
            />
          ) : (
            <div
              class="flex aspect-square w-48 flex-col items-center justify-center rounded-2xl border-2 border-dashed border-amber bg-[#fff1d6] text-[#6b4a0e] sm:w-full"
              role="img"
              aria-label="Falta la foto"
            >
              <Icon name="user" size={48} />
              <span class="mt-2 text-sm font-semibold">[FOTO PROFESIONAL]</span>
            </div>
          )}
          <div>
            <h3 class="text-2xl font-bold sm:text-3xl">{person.name}</h3>
            <p class="mt-2 font-medium text-pine">{person.role}</p>
            <div class="mt-5 max-w-2xl space-y-3 text-lg">
              {person.bio.map((line) => (
                <p>
                  <Marked text={line} />
                </p>
              ))}
            </div>
            {person.linkedin && (
              <a href={person.linkedin} target="_blank" rel="noopener" class="link mt-5 inline-flex items-center gap-2 font-medium">
                <Icon name="linkedin" size={20} />
                Ver perfil en LinkedIn
                <span class="sr-only">(se abre en una nueva pestaña)</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
