---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const a = site.audience;
---

<section id="para-quien" class="border-t border-line py-16 sm:py-24" aria-labelledby="audiencia-title">
  <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
    <div>
      <h2 id="audiencia-title" class="text-3xl leading-tight font-bold sm:text-4xl">{a.title}</h2>
      <div class="mt-8 flex items-start gap-4">
        <Icon name="users" size={36} class="mt-1 shrink-0 text-pine" />
        <div>
          <p class="font-display text-2xl font-semibold sm:text-3xl">{a.size}</p>
          <p class="mt-3 text-lg text-muted">{a.sizeText}</p>
        </div>
      </div>
    </div>

    <div>
      <h3 class="font-display text-lg font-semibold">{a.sectorsTitle}</h3>
      <ul class="mt-5 divide-y divide-line border-y border-line">
        {
          a.sectors.map((s) => (
            <li class="flex gap-4 py-5">
              <Icon name={s.icon} size={28} class="mt-0.5 shrink-0 text-pine" />
              <div>
                <p class="text-lg font-semibold">{s.title}</p>
                <p class="mt-1 text-muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
