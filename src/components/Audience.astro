---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const a = site.audience;
---

<section id="para-quien" class="py-16 sm:py-24" aria-labelledby="audiencia-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="audiencia-title" class="max-w-4xl text-[1.75rem] leading-tight font-bold sm:text-4xl lg:text-[2.75rem]">
      {a.headline}
    </h2>
    <p class="mt-4 max-w-2xl text-lg text-muted">{a.sub}</p>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:gap-14">
      <ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
        {
          a.sectors.map((s) => (
            <li class="bg-surface p-5 sm:p-6">
              <Icon name={s.icon} size={28} class="text-brand" />
              <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
              <p class="mt-1.5 text-muted">{s.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="self-start rounded-xl border border-line p-5 sm:p-6">
        <h3 class="text-lg font-semibold">{a.notForTitle}</h3>
        <ul class="mt-4 space-y-3 text-muted">
          {
            a.notFor.map((item) => (
              <li class="flex gap-3">
                <Icon name="close" size={20} class="mt-0.5 shrink-0" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
