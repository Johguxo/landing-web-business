---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const { title, intro, items } = site.problems;
---

<section id="problemas" class="py-16 sm:py-24" aria-labelledby="problemas-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 id="problemas-title" class="text-3xl leading-tight font-bold sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-muted">{intro}</p>
    </div>

    <ul class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <li class="bg-surface p-6 sm:p-7">
            <Icon name={item.icon} size={28} class="text-pine" />
            <h3 class="mt-4 text-lg leading-snug font-semibold">{item.title}</h3>
            <p class="mt-2 text-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
