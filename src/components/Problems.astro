---
/**
 * Problemas como checklist: el visitante marca los que reconoce y el contador
 * lo lleva a agendar. Funciona sin JS (las casillas se marcan igual); el JS solo actualiza el texto.
 */
import { site } from "../config/site";
import Icon from "./Icon.astro";

const p = site.problems;
---

<section id="problemas" class="py-16 sm:py-24" aria-labelledby="problemas-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 id="problemas-title" class="text-3xl leading-tight font-bold sm:text-4xl">{p.title}</h2>
      <p class="mt-4 text-lg text-muted">{p.intro}</p>
    </div>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-3" data-problems>
      {
        p.items.map((item, i) => (
          <li>
            <label
              for={`problema-${i}`}
              class="group relative flex h-full cursor-pointer gap-3.5 rounded-xl border border-line bg-surface p-4 transition-[border-color,background-color,box-shadow] duration-200 hover:border-pine/50 has-[:checked]:border-pine has-[:checked]:bg-[#EAF2EF] has-[:checked]:shadow-[inset_0_0_0_1px_var(--color-pine)] has-[:focus-visible]:outline-3 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-amber sm:flex-col sm:gap-0 sm:p-6"
            >
              <input id={`problema-${i}`} type="checkbox" class="sr-only" />
              <span class="flex items-start justify-between gap-4 sm:mb-4">
                <Icon name={item.icon} size={28} class="hidden text-pine sm:block" />
                <span
                  class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border-2 border-[#75837C] text-transparent transition-colors duration-150 group-has-[:checked]:border-pine group-has-[:checked]:bg-pine group-has-[:checked]:text-paper sm:mt-0"
                  aria-hidden="true"
                >
                  <Icon name="check" size={16} />
                </span>
              </span>
              <span class="min-w-0">
                <span class="block font-display text-lg leading-snug font-semibold">{item.title}</span>
                <span class="mt-1.5 block text-muted sm:mt-2">{item.text}</span>
              </span>
            </label>
          </li>
        ))
      }
    </ul>

    <div
      class="mt-6 flex flex-col gap-4 rounded-xl border border-line bg-surface p-5 sm:flex-row sm:items-center sm:justify-between sm:p-6"
      data-problems-result
    >
      <p class="font-medium" aria-live="polite" data-counter data-empty={p.counterEmpty} data-some={p.counterSome}>
        {p.counterEmpty}
      </p>
      <a href="#agenda" class="btn-primary shrink-0 whitespace-nowrap" data-track="click_agendar_checklist">
        {p.counterCta}
      </a>
    </div>
  </div>
</section>

<script>
  const list = document.querySelector("[data-problems]");
  const counter = document.querySelector<HTMLElement>("[data-counter]");
  const box = document.querySelector<HTMLElement>("[data-problems-result]");
  if (list && counter && box) {
    const update = () => {
      const n = list.querySelectorAll("input:checked").length;
      counter.textContent = n === 0 ? counter.dataset.empty! : counter.dataset.some!.replace("{n}", String(n));
      box.classList.toggle("is-active", n > 0);
    };
    list.addEventListener("change", update);
    update();
  }
</script>

<style>
  [data-problems-result] {
    transition: background-color 200ms ease, border-color 200ms ease, color 200ms ease;
  }
  [data-problems-result].is-active {
    background-color: var(--color-ink);
    border-color: var(--color-ink);
    color: var(--color-paper);
  }
</style>
