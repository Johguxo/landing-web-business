---
import { site } from "../config/site";

interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="30" height="30" rx="7" fill="none" stroke="currentColor" stroke-width="2"></rect>
    <path d="M8 11h7l3 5-3 5H8" fill="none" stroke="#E8A33D" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M18 16h6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
  </svg>
  <span class="font-display text-xl font-semibold tracking-tight" translate="no">{site.name}</span>
</span>
