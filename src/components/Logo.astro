---
import { site } from "../config/site";
import { markInner, type MarkVariant } from "../lib/logo";

interface Props {
  class?: string;
  /** Muestra el subtítulo de marca bajo el nombre (como en el logo completo). */
  tagline?: boolean;
  /** "light" para fondos oscuros (header, footer); "color" para fondos claros. */
  variant?: MarkVariant;
}
const { class: className = "", tagline = false, variant = "light" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg width="38" height="38" viewBox="0 0 64 64" aria-hidden="true" focusable="false" set:html={markInner(variant)} />
  <span class="flex flex-col leading-none" translate="no">
    <span class="font-display text-[1.45rem] font-bold tracking-tight">{site.name}</span>
    {
      tagline && (
        <span class="mt-1.5 text-[0.7rem] font-medium tracking-[0.18em] uppercase opacity-75" translate="yes">
          {site.tagline}
        </span>
      )
    }
  </span>
</span>
