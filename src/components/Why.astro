---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const w = site.why;
---

<section id="por-que" class="border-t border-line bg-surface py-16 sm:py-24" aria-labelledby="porque-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 id="porque-title" class="max-w-2xl text-3xl leading-tight font-bold sm:text-4xl">{w.title}</h2>

    <ul class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        w.cards.map((c) => (
          <li class="flex gap-4 sm:block">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-ink text-amber">
              <Icon name={c.icon} size={24} />
            </span>
            <div class="min-w-0">
              <h3 class="text-lg leading-snug font-semibold sm:mt-4">{c.title}</h3>
              <p class="mt-1.5 text-muted sm:mt-2">{c.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="mt-14 grid gap-6 rounded-xl border border-line bg-paper p-5 sm:p-8 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:gap-12">
      <div>
        <h3 class="text-xl leading-snug font-semibold sm:text-2xl">{w.techTitle}</h3>
        <p class="mt-3 text-muted">{w.techText}</p>
      </div>
      <ul class="flex flex-wrap gap-2" aria-label="Herramientas con las que trabajamos">
        {
          w.tech.map((t) => (
            <li class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-[0.95rem] font-medium" translate="no">
              {t}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
