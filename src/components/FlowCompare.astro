---
/**
 * Diagramas del flujo "Antes" (desordenado, con retrocesos) y "Después" (continuo).
 * Se usa dentro de BeforeAfter.astro. Las etiquetas vienen de site.beforeAfter.
 */
interface Props {
  variant: "before" | "after";
  steps: readonly string[];
}
const { variant, steps } = Astro.props;

const ys = steps.map((_, i) => 36 + i * 76);
const H = ys[ys.length - 1] + 40;

// Antes: zigzag con rotaciones leves
const nodes = steps.map((label, i) => ({
  label,
  x: i % 2 === 0 ? 54 : 126,
  y: ys[i],
  r: [-4, 3, 2, -3, 4, -2][i % 6],
}));
const links = nodes.slice(0, -1).map((a, i) => {
  const b = nodes[i + 1];
  const dir = b.x > a.x ? 1 : -1;
  return `M${a.x + dir * 16} ${a.y + 18} C ${a.x + dir * 30} ${a.y + 44}, ${b.x - dir * 30} ${b.y - 44}, ${b.x - dir * 14} ${b.y - 18}`;
});
const first = nodes[0];
const last = nodes[nodes.length - 1];
---

{
  variant === "before" ? (
    <svg viewBox={`0 0 180 ${H}`} class="h-auto w-full overflow-visible" role="presentation" aria-hidden="true">
      <g fill="none" stroke="#7E948C" stroke-width="1.6" stroke-dasharray="5 5" stroke-linecap="round">
        {links.map((d) => <path d={d} />)}
        {/* retrocesos: el dato vuelve atrás para confirmarse */}
        <path d={`M${last.x - 52} ${last.y} C -14 ${last.y - 120}, -14 ${first.y + 120}, ${first.x - 52} ${first.y}`} stroke="#E8A33D" stroke-opacity="0.85" />
        <path d={`M176 ${ys[3]} C 192 ${ys[3] - 60}, 192 ${ys[1] + 60}, 176 ${ys[1] + 4}`} />
      </g>
      <g font-size="12" class="font-display" font-weight="600" fill="#E8A33D" text-anchor="middle">
        <text x="-10" y={(first.y + last.y) / 2}>?</text>
        <text x="194" y={(ys[1] + ys[3]) / 2}>?</text>
      </g>
      {nodes.map((p) => (
        <g transform={`rotate(${p.r} ${p.x} ${p.y})`}>
          <rect x={p.x - 50} y={p.y - 18} width="100" height="36" rx="6" fill="#10211D" stroke="#5F7A71" stroke-width="1.5" stroke-dasharray="4 3" />
          <text x={p.x} y={p.y + 6} text-anchor="middle" font-size="16" class="font-sans" fill="#D7DFDA">
            {p.label}
          </text>
        </g>
      ))}
    </svg>
  ) : (
    <svg viewBox={`0 0 180 ${H}`} class="h-auto w-full" role="presentation" aria-hidden="true">
      <line x1="90" y1={ys[0]} x2="90" y2={ys[ys.length - 1]} stroke="#E8A33D" stroke-width="2.5" class="flow-line" style={`--len:${ys[ys.length - 1] - ys[0]}`} />
      {steps.map((label, i) => (
        <g class="flow-node" style={`--i:${i}`}>
          <rect x="4" y={ys[i] - 19} width="172" height="38" rx="8" fill="#10211D" stroke="#8FC9B8" stroke-width="1.5" />
          <circle cx="24" cy={ys[i]} r="7" fill="#E8A33D" />
          <path d={`M20.5 ${ys[i]} l2.5 2.5 l4.5 -5`} fill="none" stroke="#10211D" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          <text x="100" y={ys[i] + 6} text-anchor="middle" font-size="16" class="font-sans" font-weight="500" fill="#F3F4F1">
            {label}
          </text>
        </g>
      ))}
    </svg>
  )
}

<style>
  /* Una sola animación: el flujo conectado se dibuja cuando la sección entra en pantalla.
     Sin JS o con movimiento reducido, se ve completo desde el inicio. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.reveal-ready) .flow-line {
      stroke-dasharray: var(--len);
      stroke-dashoffset: var(--len);
    }
    :global(.reveal-ready) .flow-node {
      opacity: 0;
    }
    :global(.reveal-ready.is-visible) .flow-line {
      animation: draw 1.2s 0.2s ease-out forwards;
    }
    :global(.reveal-ready.is-visible) .flow-node {
      animation: appear 0.35s ease-out forwards;
      animation-delay: calc(0.2s + var(--i) * 0.18s);
    }
    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
    @keyframes appear {
      to {
        opacity: 1;
      }
    }
  }
</style>
