---
/**
 * CTA final: formulario de 3 campos que abre WhatsApp con el mensaje armado (sin backend).
 * Si hay calendlyUrl, además se muestra el calendario debajo.
 */
import { site, whatsappHref, mailtoHref } from "../config/site";
import Icon from "./Icon.astro";
import Marked from "./Marked.astro";

const b = site.booking;
const f = b.form;
const waDigits = site.contact.whatsapp.replace(/\D/g, "");
const waBase = `https://wa.me/${waDigits}`;

const calendlyBase = site.contact.calendlyUrl.trim();
let calendlyUrl = "";
if (calendlyBase) {
  const u = new URL(calendlyBase);
  u.searchParams.set("hide_gdpr_banner", "1");
  u.searchParams.set("primary_color", "0f5c4d");
  calendlyUrl = u.href;
}
const hasCalendly = Boolean(calendlyUrl);

const inputClass =
  "mt-1.5 block w-full rounded-lg border border-transparent bg-paper px-3.5 py-3 text-base text-ink placeholder:text-[#6B7A73] focus:border-amber focus:outline-none focus-visible:outline-3 focus-visible:outline-offset-0 focus-visible:outline-amber";
---

<section id="agenda" class="border-t border-line bg-surface py-16 sm:py-24" aria-labelledby="agenda-title">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_0.95fr] lg:gap-16">
    <div>
      <h2 id="agenda-title" class="text-3xl leading-tight font-bold sm:text-4xl">{b.title}</h2>
      <p class="mt-4 text-lg text-muted">{b.text}</p>
      <p class="mt-3 font-medium text-pine">{site.cta.note}</p>

      <h3 class="mt-9 text-lg font-semibold">{b.agendaTitle}</h3>
      <ol class="mt-4 border-l-2 border-line">
        {
          b.agenda.map((step) => (
            <li class="relative pb-5 pl-6 last:pb-0">
              <span class="absolute top-1.5 -left-[7px] h-3 w-3 rounded-full border-2 border-surface bg-amber" aria-hidden="true" />
              <p class="text-sm font-semibold text-pine tabular-nums">{step.time}</p>
              <p class="mt-1">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="self-start rounded-xl bg-ink p-5 text-paper sm:p-8">
      <h3 class="text-xl font-semibold">{f.title}</h3>
      <form class="mt-5 space-y-4" action={waBase} method="get" target="_blank" data-lead-form data-wa={waBase} data-intro={f.messageIntro} novalidate>
        <div>
          <label for="lead-nombre" class="text-[0.95rem] font-medium">{f.nameLabel}</label>
          <input id="lead-nombre" name="nombre" type="text" autocomplete="name" required maxlength="80" class={inputClass} />
          <p class="mt-1.5 hidden text-sm text-amber" data-error-for="lead-nombre">Escribe tu nombre.</p>
        </div>
        <div>
          <label for="lead-empresa" class="text-[0.95rem] font-medium">{f.companyLabel}</label>
          <input id="lead-empresa" name="empresa" type="text" autocomplete="organization" required maxlength="100" class={inputClass} />
          <p class="mt-1.5 hidden text-sm text-amber" data-error-for="lead-empresa">Escribe el nombre de tu empresa.</p>
        </div>
        <div>
          <label for="lead-proceso" class="text-[0.95rem] font-medium">{f.problemLabel}</label>
          <textarea id="lead-proceso" name="text" rows="3" required maxlength="500" placeholder={f.problemPlaceholder} class={`${inputClass} resize-y`}></textarea>
          <p class="mt-1.5 hidden text-sm text-amber" data-error-for="lead-proceso">Cuéntanos en una línea qué proceso te complica.</p>
        </div>
        <button type="submit" class="btn-primary w-full text-lg" data-track="submit_formulario">
          <Icon name="whatsapp" size={22} />
          {f.submit}
        </button>
        <p class="text-center text-sm text-muted-dark">{f.helper}</p>
      </form>

      <div class="mt-6 border-t border-line-dark pt-5">
        <p class="text-sm text-muted-dark">{b.altTitle}</p>
        <ul class="mt-3 space-y-2.5">
          <li class="flex items-center gap-3">
            <Icon name="whatsapp" size={20} class="text-pine-light" />
            <a href={whatsappHref()} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-amber" data-track="click_whatsapp">
              {b.whatsappLabel}
              <span class="sr-only">(se abre en una nueva pestaña)</span>
            </a>
            <span class="text-muted-dark"><Marked text={site.contact.whatsapp} /></span>
          </li>
          <li class="flex items-center gap-3">
            <Icon name="mail" size={20} class="text-pine-light" />
            <a href={mailtoHref()} class="underline underline-offset-4 hover:text-amber" data-track="click_email">
              <Marked text={site.contact.email} />
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>

  {
    hasCalendly && (
      <div class="mx-auto mt-14 max-w-6xl px-4 sm:px-6">
        <h3 class="text-xl font-semibold">{b.calendarTitle}</h3>
        <div class="mt-5 overflow-hidden rounded-xl border border-line bg-paper">
          <div class="calendly-inline-widget h-[1040px] min-w-[320px] sm:h-[760px]" data-url={calendlyUrl} data-calendly>
            <div class="flex h-40 flex-col items-center justify-center gap-2 p-6 text-center text-muted" data-calendly-loading>
              <Icon name="calendar" size={28} class="text-pine" />
              <p>{b.calendarLoading}</p>
              <a href={calendlyBase} target="_blank" rel="noopener" class="link text-sm">
                {b.calendarFallback}
              </a>
            </div>
          </div>
        </div>
      </div>
    )
  }
</section>

<script>
  // Formulario → WhatsApp con mensaje armado. Validación propia para mostrar errores junto a cada campo.
  const form = document.querySelector<HTMLFormElement>("[data-lead-form]");
  if (form) {
    const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input, textarea"));
    const showError = (el: HTMLInputElement | HTMLTextAreaElement, show: boolean) => {
      const msg = form.querySelector<HTMLElement>(`[data-error-for="${el.id}"]`);
      msg?.classList.toggle("hidden", !show);
      el.setAttribute("aria-invalid", String(show));
      if (msg) {
        msg.id = `${el.id}-error`;
        if (show) el.setAttribute("aria-describedby", msg.id);
        else el.removeAttribute("aria-describedby");
      }
    };
    fields.forEach((el) => el.addEventListener("blur", () => el.value.trim() && showError(el, false)));
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const invalid = fields.filter((el) => !el.value.trim());
      fields.forEach((el) => showError(el, invalid.includes(el)));
      if (invalid.length) {
        invalid[0].focus();
        return;
      }
      const [nombre, empresa, proceso] = fields.map((el) => el.value.trim());
      const text = `${form.dataset.intro}\n\nNombre: ${nombre}\nEmpresa: ${empresa}\nProceso que más problemas genera: ${proceso}`;
      const url = `${form.dataset.wa}?text=${encodeURIComponent(text)}`;
      // Enlace temporal: abre WhatsApp en otra pestaña (en celular, abre la app).
      const link = Object.assign(document.createElement("a"), { href: url, target: "_blank", rel: "noopener" });
      link.click();
    });
  }
</script>

{
  hasCalendly && (
    <script>
      // Carga Calendly solo cuando está cerca de la pantalla (no afecta la carga inicial).
      const widget = document.querySelector<HTMLElement>("[data-calendly]");
      if (widget) {
        const io = new IntersectionObserver(
          (entries) => {
            if (entries.some((e) => e.isIntersecting)) {
              io.disconnect();
              const s = document.createElement("script");
              s.src = "https://assets.calendly.com/assets/external/widget.js";
              s.async = true;
              s.onload = () => widget.querySelector("[data-calendly-loading]")?.remove();
              document.head.appendChild(s);
            }
          },
          { rootMargin: "600px 0px" },
        );
        io.observe(widget);
      }
    </script>
  )
}
