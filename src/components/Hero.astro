---
import { site } from "../config/site";
---

<section id="inicio" class="bg-ink pt-16 text-paper">
  <div class="mx-auto max-w-6xl px-4 pt-12 pb-16 sm:px-6 sm:pt-20 md:pb-24 lg:pt-28 lg:pb-32">
    <h1 class="max-w-4xl text-[2.25rem] leading-[1.1] font-bold sm:text-6xl lg:text-7xl">
      {site.hero.title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted-dark sm:text-xl">{site.hero.subtitle}</p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
      <a href="#agenda" class="btn-primary sm:!px-7 sm:text-lg" data-track="click_cta_hero">
        {site.cta.primary}
      </a>
      <a href="#que-hacemos" class="btn-secondary whitespace-nowrap text-paper/90 hover:bg-ink-2">
        {site.hero.secondary}
      </a>
    </div>
    <p class="mt-4 text-[0.95rem] text-muted-dark">{site.cta.note}</p>
  </div>
</section>
