---
import { site } from "../config/site";

const { title, intro, steps } = site.process;
---

<section id="como-trabajamos" class="border-t border-line bg-surface py-16 sm:py-24" aria-labelledby="proceso-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 id="proceso-title" class="text-3xl leading-tight font-bold sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-muted">{intro}</p>
    </div>

    <ol class="relative mt-12 grid gap-10 lg:grid-cols-4 lg:gap-8">
      <!-- línea que une los pasos -->
      <span class="absolute top-5 bottom-5 left-5 w-px bg-line lg:top-5 lg:right-5 lg:bottom-auto lg:left-5 lg:h-px lg:w-auto" aria-hidden="true"></span>
      {
        steps.map((step, i) => (
          <li class="relative pl-16 lg:pl-0">
            <span
              class="absolute top-0 left-0 flex h-10 w-10 items-center justify-center rounded-full bg-ink font-display text-lg font-semibold text-amber lg:relative"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <h3 class="text-xl font-semibold lg:mt-6">
              <span class="sr-only">Paso {i + 1}: </span>
              {step.title}
            </h3>
            <p class="mt-2 text-muted">{step.text}</p>
            <p class="mt-4 border-l-2 border-amber pl-3 text-[0.95rem] font-medium">{step.result}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
