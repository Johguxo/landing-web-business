---
import { site, whatsappHref, mailtoHref } from "../config/site";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import Marked from "./Marked.astro";

const year = new Date().getFullYear();
---

<footer class="bg-ink py-12 text-paper">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 sm:px-6 md:flex-row md:items-end md:justify-between">
    <div>
      <Logo tagline />
      <p class="mt-4 text-muted-dark">{site.city}</p>
    </div>
    <ul class="flex flex-col gap-2 text-muted-dark md:items-end">
      <li><a href={mailtoHref()} class="hover:text-paper"><Marked text={site.contact.email} /></a></li>
      <li><a href={whatsappHref()} target="_blank" rel="noopener" class="hover:text-paper">WhatsApp</a></li>
      {
        site.contact.linkedin && (
          <li>
            <a href={site.contact.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-2 hover:text-paper">
              <Icon name="linkedin" size={18} />
              LinkedIn
              <span class="sr-only">(se abre en una nueva pestaña)</span>
            </a>
          </li>
        )
      }
    </ul>
  </div>
  <div class="mx-auto mt-10 max-w-6xl px-4 text-sm text-muted-dark sm:px-6">
    <p class="border-t border-line-dark pt-6">
      © {year} <Marked text={site.legalName} />{site.ruc && ` · RUC ${site.ruc}`}. Todos los derechos reservados.
    </p>
  </div>
</footer>
