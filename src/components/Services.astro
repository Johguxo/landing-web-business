---
import { site } from "../config/site";
import Icon from "./Icon.astro";

const s = site.services;
---

<section id="que-hacemos" class="border-t border-line bg-surface py-16 sm:py-24" aria-labelledby="servicios-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="max-w-2xl">
      <h2 id="servicios-title" class="text-3xl leading-tight font-bold sm:text-4xl">{s.title}</h2>
      <p class="mt-4 text-lg text-muted">{s.intro}</p>
    </div>

    <ul class="mt-10 grid gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        s.areas.map((area) => (
          <li class="bg-surface p-5 sm:p-7">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#EAF2EF] text-pine">
                <Icon name={area.icon} size={22} />
              </span>
              <h3 class="text-xl font-semibold">{area.title}</h3>
            </div>
            <ul class="mt-4 space-y-2">
              {area.items.map((item) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={18} class="mt-1 shrink-0 text-pine" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
